{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": ["--watch", "ucu-lost-found/server/src/server.js"],
      "env": { "PORT": "4100" },
      "port": 4100,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": ["ucu-lost-found/client/node_modules/vite/bin/vite.js", "ucu-lost-found/client"],
      "env": { "API_PROXY": "http://localhost:4100" },
      "port": 5173
    }
  ]
}
