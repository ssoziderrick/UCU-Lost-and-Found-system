{
  "name": "ucu-lost-found-server",
  "version": "1.0.0",
  "description": "Express + MySQL API for the UCU Campus Lost-and-Found System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:setup": "node scripts/setup-db.js",
    "test": "jest --runInBand",
    "admin:create": "node scripts/create-admin.js",
    "match:sweep": "node scripts/match-sweep.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
