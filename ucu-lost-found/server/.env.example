# Copy to server/.env and fill in. server/.env is git-ignored: never commit real values.
PORT=4000
NODE_ENV=development

# MySQL connection (use a dedicated app user, not root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=lf_app
DB_PASSWORD=change-me
DB_NAME=ucu_lost_found
# Separate database used by automated tests (it is wiped on every run)
DB_NAME_TEST=ucu_lost_found_test
# true for hosted MySQL providers that require TLS
DB_SSL=false

# How long a normal login lasts, in hours
SESSION_HOURS=8

# Public address of the web app, used in emailed links (activation, password reset, invitations)
APP_URL=http://localhost:5173
# Keys the hash of one-time codes. Required in production: at least 32 random characters.
APP_SECRET=
# Registration-number format after normalising (upper-case, no spaces). Replace once UCU confirms its format.
# REG_NUMBER_PATTERN=^[A-Z0-9][A-Z0-9/-]{3,19}$

# Email: "log" prints messages and stores them in email_outbox (development only).
# Production must use "smtp" with an approved sender.
MAIL_TRANSPORT=log
MAIL_FROM=UCU Findora <no-reply@findora.local>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
